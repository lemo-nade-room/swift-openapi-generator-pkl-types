import "https://raw.githubusercontent.com/lemo-nade-room/swift-openapi-generator-pkl-types/main/types.pkl" as OpenAPIGenerator

// cd Examples && pkl eval http-import.pkl > openapi-generator-config.yaml

config: OpenAPIGenerator.Config = new {
  generate = new Listing {
    "types"
    "client"
    "server"
  }
  accessModifier    = "public"
  additionalImports = new Listing { "Foundation" }
  filter = new OpenAPIGenerator.DocumentFilter {
    operations = new Listing { "getPetById"; "addPet" }
    tags       = new Listing { "pet" }
  }
  namingStrategy = "idiomatic"
  nameOverrides  = new Mapping {
    ["OldTypeName"] = "NewTypeName"
  }
  featureFlags = new Listing { "empty" }
}
output {
  value = config
  renderer = new YamlRenderer {}
}