module OpenAPIGenerator

typealias GeneratorMode = "types" | "client" | "server"
typealias AccessModifier = "public" | "package" | "internal" | "fileprivate" | "private"
typealias NamingStrategy  = "defensive" | "idiomatic"
typealias FeatureFlag     = "empty"

typealias FeatureFlags = Listing<FeatureFlag>(isDistinct)

class DocumentFilter {
  operations: Listing<String>?
  tags:       Listing<String>?
  paths:      Listing<String>?
  schemas:    Listing<String>?
}

class Config {
  generate:           Listing<GeneratorMode>
  accessModifier:     AccessModifier?
  additionalImports:  Listing<String>?
  filter:             DocumentFilter?
  namingStrategy:     NamingStrategy?
  nameOverrides:      Mapping<String, String>?
  featureFlags:       FeatureFlags?
}
